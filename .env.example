# 本地数据目录（相对路径相对于项目根目录）
VOXNOTE_DATA_DIR=./data
VOXNOTE_MAX_UPLOAD_MB=2048

# 模型缓存默认放在项目目录；Windows 可改成 E:/VoxNote/model-cache 等绝对路径
MODELSCOPE_CACHE=./model-cache
HF_HOME=./hf-cache
HUGGINGFACE_HUB_CACHE=./hf-cache/hub
TORCH_HOME=./torch-cache

# Windows 可填写已安装 CUDA PyTorch 的 Python 路径，供 scripts/run_gpu.ps1 使用
# VOXNOTE_PYTHON=C:/path/to/gpu/python.exe

# Windows/macOS/Linux 均可：安装 ffmpeg 后一般直接填 ffmpeg 即可
FFMPEG_BINARY=ffmpeg

# 默认 funasr；首次转写会下载模型到本机缓存。验收 UI/导出时可临时设为 mock
TRANSCRIBER_BACKEND=funasr
MOCK_TRANSCRIPTION=false
FUNASR_DEVICE=cuda:0
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_SPK_MODEL=cam++
FUNASR_BATCH_SIZE_S=300
VAD_MAX_SINGLE_SEGMENT_TIME_MS=30000

# DeepSeek 或任意 OpenAI 兼容 chat/completions 服务；也可以只在网页中填写 API Key
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
